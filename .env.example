# Copy to .env in apps/web and apps/worker as needed. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Unipile (LinkedIn connectivity)
UNIPILE_DSN=https://api1.unipile.com:13111
UNIPILE_ACCESS_TOKEN=
UNIPILE_WEBHOOK_SECRET=

# Redis for BullMQ
REDIS_URL=redis://localhost:6379

# App
APP_URL=http://localhost:3000
WORKER_PORT=4000
# Web app needs this to reach the worker for job dispatch.
WORKER_URL=http://localhost:4000

# HubSpot OAuth. Redirect URI is $WORKER_URL/auth/hubspot/callback.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
CRM_PROVIDER=auto

# Email. Set EMAIL_PROVIDER=mock in development to capture instead of sending,
# or "off" to disable notifications entirely.
EMAIL_PROVIDER=off
RESEND_API_KEY=
EMAIL_FROM="LinkedIn Employee <hello@yourdomain.com>"
EMAIL_REPLY_TO=

# Microsoft 365 calendar. Callback is $WORKER_URL/auth/microsoft/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Salesforce Connected App. Callback is $WORKER_URL/auth/salesforce/callback.
# Set SALESFORCE_LOGIN_URL=https://test.salesforce.com for a sandbox org.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=

# Stripe. Webhook endpoint is $WORKER_URL/webhooks/stripe. Price lookup keys
# must be "solo", "pro" and "teams" so the webhook can map them to plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAMS=

# Google Calendar OAuth. Redirect URI is $WORKER_URL/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_PROVIDER=google
MEETING_DURATION_MINUTES=30

# Encrypts OAuth tokens before they are stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=

# Public base URL of the worker, used for OAuth redirects and webhooks.
WORKER_URL=http://localhost:4000

# Shared between the web app and the worker to authenticate internal job
# dispatch. Both services must have the same value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=
