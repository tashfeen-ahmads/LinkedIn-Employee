# Copy to .env in apps/web and apps/worker as needed. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Unipile (LinkedIn connectivity)
UNIPILE_DSN=https://api1.unipile.com:13111
UNIPILE_ACCESS_TOKEN=
UNIPILE_WEBHOOK_SECRET=

# Redis for BullMQ
REDIS_URL=redis://localhost:6379

# App
#
# Two hosts in production: the marketing site on the apex and the dashboard on
# app., which is the only one that ever holds a session. Locally they are the
# same origin, so one value does both.
#
# APP_URL is the origin Supabase redirects back to after a sign-in, so getting
# it wrong drops people on a host that cannot see the session they just got.
APP_URL=http://localhost:3000
# The marketing origin: canonicals, the sitemap, OG images. Leave it unset on
# a preview deploy only if you want the preview declaring itself canonical to
# production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WORKER_PORT=4000
# Web app needs this to reach the worker for job dispatch.
WORKER_URL=http://localhost:4000

# HubSpot OAuth. Redirect URI is $WORKER_URL/auth/hubspot/callback.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
CRM_PROVIDER=auto

# Email. Set EMAIL_PROVIDER=mock in development to capture instead of sending,
# or "off" to disable notifications entirely.
EMAIL_PROVIDER=off
RESEND_API_KEY=
EMAIL_FROM="Nora <hello@yourdomain.com>"
# Replies to the welcome and the day-7 check-in come here, and those emails
# promise a person reads them. Point it at an inbox somebody does.
EMAIL_REPLY_TO=
# Worker. Extra inboxes told about every signup, finished onboarding and
# connected LinkedIn account, comma-separated. Everybody in le.platform_admins
# is told already; this is for an operator address that is not a user.
ADMIN_NOTIFY_EMAILS=
# Worker. A postal address for the footer of marketing email (the onboarding
# sequence and announcements), which commercial-email law asks for. Optional.
EMAIL_POSTAL_ADDRESS=
# The onboarding sequence and announcements carry a one-click unsubscribe link
# signed with a key derived from INTERNAL_API_SECRET; without that secret the
# worker sends no marketing email at all rather than one with a dead link.

# Microsoft 365 calendar. Callback is $WORKER_URL/auth/microsoft/callback.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Salesforce Connected App. Callback is $WORKER_URL/auth/salesforce/callback.
# Set SALESFORCE_LOGIN_URL=https://test.salesforce.com for a sandbox org.
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=

# Stripe. Webhook endpoint is $WORKER_URL/webhooks/stripe. Price lookup keys
# must be "solo", "pro" and "teams" so the webhook can map them to plans.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAMS=

# Google Calendar OAuth. Redirect URI is $WORKER_URL/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_PROVIDER=google
MEETING_DURATION_MINUTES=30

# Encrypts OAuth tokens before they are stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=

# Public base URL of the worker, used for OAuth redirects and webhooks.
WORKER_URL=http://localhost:4000

# Shared between the web app and the worker to authenticate internal job
# dispatch. Both services must have the same value. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# The trial limit. Off unless this is exactly "true": until pricing and the
# trial are decided, no workspace's campaigns pause on a trial end date and no
# "your trial ends" email goes out. Set it on BOTH the web app and the worker
# when it is switched back on, or the sidebar and the sending loop disagree.
TRIAL_LIMIT_ENFORCED=
